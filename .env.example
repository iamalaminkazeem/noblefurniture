# ── DATABASE (Neon) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/noble_furniture?sslmode=require"

# ── AUTH (Clerk) — for the /admin dashboard ─────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxx"
CLERK_SECRET_KEY="sk_live_xxxxxxxx"

# ── PAYMENTS (Paystack) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxx"

# ── EMAIL (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Noble Furniture Gallery <no-reply@noblefurnituregallery.com>"
ADMIN_NOTIFICATION_EMAIL="hello@noblefurnituregallery.com"

# ── IMAGES (ImageKit) — powers image upload in the admin dashboard
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxx"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# ── SPAM PROTECTION (Google reCAPTCHA v3) ────────────────────────
# From google.com/recaptcha/admin — register your domain, choose v3.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lxxxxxxxxxxxxxxxxxx"
RECAPTCHA_SECRET_KEY="6Lxxxxxxxxxxxxxxxxxx"

# ── SITE ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://noblefurnituregallery.com"

# Comma-separated list of emails allowed into /admin.
# Must match the email on the Clerk account you sign in with.
ADMIN_EMAILS="your-real-email@example.com"